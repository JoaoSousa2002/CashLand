{
  "openapi": "3.0.0",
  "info": {
    "title": "CashLand API",
    "version": "1.0.0",
    "description": "API de autenticação e gerenciamento do CashLand"
  },
  "servers": [
    {
      "url": "https://cashland-cdf0.onrender.com",
      "description": "Servidor web render"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "summary": "Autentica um usuário",
        "tags": [
          "Autenticação"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "senha"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com"
                  },
                  "senha": {
                    "type": "string",
                    "example": "minhaSenha123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "401": {
            "description": "Email ou senha inválidos"
          },
          "429": {
            "description": "Muitas tentativas realizadas para esta operação. Tente novamente em 15 minutos"
          }
        }
      }
    },
    "/confirmar-cadastro": {
      "post": {
        "summary": "Recebe o codigo do usuario e verifica se é o mesmo enviado, se sim, cria o usuario",
        "tags": [
          "Cadastramento de usuario"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "email",
                  "senha"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "Usuario teste"
                  },
                  "email": {
                    "type": "string",
                    "example": "usuario@gmail.com"
                  },
                  "senha": {
                    "type": "string",
                    "example": "minhaSenha123"
                  },
                  "codigoDigitado": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cadastro realizado com sucesso, prossiga para o login!"
          },
          "201": {
            "description": "Usuario criado, mas o email de confirmação não foi enviado, erro"
          },
          "400": {
            "description": "Dados inválidos ou incompletos"
          },
          "401": {
            "description": "-Erro de codigo (Incorreto, expirado ou não solicitado)"
          },
          "429": {
            "description": "Muitas tentativas realizadas para esta operação. Tente novamente em 15 minutos"
          },
          "500": {
            "description": "Erro ao cadastrar usuário"
          }
        }
      }
    },
    "/solicitar-codigo": {
      "post": {
        "summary": "Envia codigo ao email enviado pelo usuario e verifica se o Email é valido",
        "tags": [
          "Solicita codigo por Email"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "email"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "Joao Sousa"
                  },
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Codigo enviado para o email!"
          },
          "400": {
            "description": "Dados inválidos ou incompletos"
          },
          "409": {
            "description": "Esse email já está cadastrado"
          },
          "429": {
            "description": "Muitas tentativas realizadas para esta operação. Tente novamente em 15 minutos"
          },
          "500": {
            "description": "O envio de email falhou: erro"
          }
        }
      }
    },
    "/solicitar-reset-senha": {
      "post": {
        "summary": "Solicita um código de verificação para redefinir a senha",
        "tags": [
          "Redefinição de Senha"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@gmail.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código enviado para o email!"
          },
          "400": {
            "description": "Email inválido ou não informado"
          },
          "404": {
            "description": "Email não cadastrado"
          },
          "429": {
            "description": "Muitas tentativas realizadas para esta operação. Tente novamente em 15 minutos"
          },
          "500": {
            "description": "Não foi possível enviar o código"
          }
        }
      }
    },
    "/confirmar-reset-senha": {
      "post": {
        "summary": "Confirma o código de verificação e atualiza a senha",
        "tags": [
          "Redefinição de Senha"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "codigoDigitado",
                  "novaSenha"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@gmail.com"
                  },
                  "codigoDigitado": {
                    "type": "string",
                    "example": "123456"
                  },
                  "novaSenha": {
                    "type": "string",
                    "example": "minhaNovaSenha123",
                    "description": "Mínimo de 10 caracteres"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha alterada com sucesso!"
          },
          "400": {
            "description": "Dados inválidos ou incompletos (código inválido/expirado ou senha menor que 10 caracteres)"
          },
          "404": {
            "description": "Usuário não encontrado"
          },
          "429": {
            "description": "Muitas tentativas realizadas para esta operação. Tente novamente em 15 minutos"
          },
          "500": {
            "description": "Erro ao atualizar senha"
          }
        }
      }
    }
  }
}