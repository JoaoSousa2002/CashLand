            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Usuario reativado com sucesso"
                }
              }
            }
          },
          "400": {
            "description": "Usuario já está ativo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Usuario já está ativo"
