    "/admin/reativar-usuario": {
      "patch": {
        "summary": "Reativa um usuário (Admin)",
        "description": "Define status_usuario como Ativo e limpa data_inativacao.",
        "tags": [
          "Administração de usuários"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
