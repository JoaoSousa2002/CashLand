    "/admin/desativar-usuario": {
      "patch": {
        "summary": "Desativa um usuário comum (Admin)",
        "description": "Exige id no corpo. Impede desativar qualquer conta do tipo Admin, inclusive a própria. Define status_usuario como Inativo e registra data_inativacao.",
        "tags": [
          "Administração de usuários"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario desativado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Usuario desativado com sucesso"
                }
              }
            }
          },
          "400": {
            "description": "ID ausente ou usuário já desativado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Informe o id do usuário"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Usuário não encontrado"
                }
              }
            }
          },
          "500": {
            "description": "Erro ao desativar a conta, tente novamente mais tarde",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Erro ao desativar a conta, tente novamente mais tarde"
                }
              }
            }
          },
          "403": {
            "description": "JWT sem tipo Admin ou tentativa de desativar uma conta Admin.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/Erro"
                    },
                    {
                      "$ref": "#/components/schemas/Mensagem"
                    }
                  ]
                },
                "examples": {
                  "semPermissao": {
                    "value": {
                      "erro": "Acesso restrito a administradores"
                    }
                  },
                  "contaAdmin": {
                    "value": {
                      "mensagem": "Admin não pode desativar própria conta ou de outro admin"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "example": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token",
        "description": "JWT definido pelo POST /login em cookie HttpOnly. As rotas administrativas exigem tipo Admin no token."
      }
    },
    "schemas": {
      "Mensagem": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string"
          }
        }
      },
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string"
          }
        }
      },
      "UsuarioAdministrativo": {
        "type": "object",
        "properties": {
          "id_usuario": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "example": "Admin"
          },
          "status_usuario": {
            "type": "string",
            "example": "Ativo"
          },
          "data_criacao": {
            "type": "string",
            "format": "date-time"
          },
          "data_inativacao": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id_usuario": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status_usuario": {
            "type": "string",
            "example": "Ativo"
          },
          "data_criacao": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DetalheUsuarioAdministrativo": {
        "type": "object",
        "properties": {
          "id_usuario": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "status_usuario": {
            "type": "string",
            "example": "Ativo"
          },
          "data_criacao": {
            "type": "string",
            "format": "date-time"
          },
          "data_inativacao": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    },
    "responses": {
      "NaoAutenticado": {
        "description": "Não autenticado ou token inválido ou expirado",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Mensagem"
            }
          }
        }
      },
      "SomenteAdmin": {
        "description": "Acesso restrito a administradores",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Erro"
            },
            "example": {
              "erro": "Acesso restrito a administradores"
            }
          }
        }
      },
      "LimiteCodigo": {
        "description": "Limite compartilhado de 5 requisições por IP a cada 15 minutos atingido",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Mensagem"
            },
            "example": {
              "mensagem": "Muitas tentativas de realizadas para esta operação. Tente novamente em 15 minutos."
            }
          }
        }
      },
      "LimiteLogin": {
        "description": "Limite compartilhado entre login e confirmação de senha: 5 requisições por IP a cada 5 minutos.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Mensagem"
            },
            "example": {
              "mensagem": "Muitas tentativas de login realizadas. Tente novamente em 5 minutos."
            }
          }
        }
      },
      "LimiteCadastro": {
        "description": "Muitas tentativas de cadastro realizadas. Tente novamente em 15 minutos.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Mensagem"
            },
            "example": {
              "mensagem": "Muitas tentativas de cadastro realizadas. Tente novamente em 15 minutos."
            }
          }
        }
      }
    }
  }
}
