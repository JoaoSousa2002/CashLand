{
  "openapi": "3.0.0",
  "info": {
    "title": "CashLand API",
    "version": "1.0.0",
    "description": "API de autenticação e gerenciamento do CashLand"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "summary": "Autentica um usuário",
        "tags": [
          "Autenticação"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "senha"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com"
                  },
                  "senha": {
                    "type": "string",
                    "example": "minhaSenha123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso"
          },
          "401": {
            "description": "Email ou senha inválidos"
          }
        }
      }
    }, "/cadastrar-usuario": {
      "post": {
        "summary": "cadastra um  novo usuário",
        "tags": [
          "Cadastramento de usuario"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "email",
                  "senha"
                ],
                "properties": {
                  "nome":{
                    "type": "string",
                    "example": "Joao Sousa"
                  },
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com"
                  },
                  "senha": {
                    "type": "string",
                    "example": "minhaSenha123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cadastro realizado com sucesso, prossiga para o login!"
          },
          "40": {
            "description": "Esse email já está cadastrado"
          }
        }
      }
    }
  }
}