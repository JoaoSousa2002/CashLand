{
  "openapi": "3.0.0",
  "info": {
    "title": "CashLand API",
    "version": "1.0.0",
    "description": "API de autenticação e gerenciamento do CashLand. A sessão usa o cookie HttpOnly token. POST /login e POST /confirmar-senha compartilham 5 requisições por IP a cada 5 minutos. POST /confirmar-cadastro permite 5 requisições por IP a cada 15 minutos. POST /logout, POST /solicitar-codigo, POST /solicitar-reset-senha e POST /confirmar-reset-senha compartilham 5 requisições por IP a cada 15 minutos. As rotas /admin não usam esses limitadores e exigem tipo Admin no JWT. Páginas HTML (/tela-admin e /tela-principal, incluindo suas subrotas) e a interface /api-docs não são operações desta API."
  },
  "servers": [
    {
      "url": "https://cashland-cdf0.onrender.com",
      "description": "Servidor web render"
    },
    {
      "url": "http://localhost:3000",
      "description": "Servidor local"
    }
  ],
  "paths": {
    "/login": {
      "post": {
        "summary": "Autentica um usuário",
        "description": "Define o cookie token com HttpOnly, SameSite=Strict e validade de 2 horas. Em produção, o cookie também usa Secure. Se status_reset_senha estiver ativo, retorna 203 antes de validar a senha, sem emitir cookie. O usuário deve concluir o fluxo de redefinição de senha.",
        "tags": [
          "Autenticação"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "senha"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com"
                  },
                  "senha": {
                    "type": "string",
                    "example": "minhaSenha123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "headers": {
              "Set-Cookie": {
                "description": "Cookie token contendo o JWT da sessão.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensagem": {
                      "type": "string",
                      "example": "Login realizado com sucesso"
                    },
                    "usuario": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "example": 1
                        },
                        "nome": {
                          "type": "string"
                        },
                        "tipo": {
                          "type": "string",
                          "example": "Admin"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Email e senha são obrigatórios",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "401": {
            "description": "Email ou senha inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "403": {
            "description": "Conta inativa. Contate o administrador.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Conta inativa. Contate o administrador."
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/LimiteLogin"
          },
          "203": {
            "description": "Reset de senha solicitado por um adminstrador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Reset de senha solicitado por um adminstrador"
                }
              }
            }
          }
        }
      }
    },
    "/confirmar-cadastro": {
      "post": {
        "summary": "Confirma o código e cria o usuário",
        "tags": [
          "Cadastramento de usuario"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "email",
                  "senha",
                  "codigoDigitado"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "Usuario teste"
                  },
                  "email": {
                    "type": "string",
                    "example": "usuario@gmail.com"
                  },
                  "senha": {
                    "type": "string",
                    "minLength": 10,
                    "example": "minhaSenha123"
                  },
                  "codigoDigitado": {
                    "type": "string",
                    "example": "123456"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cadastro realizado com sucesso, prossiga para o login!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "201": {
            "description": "Usuário criado, mas o envio do email de confirmação falhou.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensagem": {
                      "type": "string"
                    },
                    "erro": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "example": {
                  "mensagem": "Usuario criado, mas o email de confirmação não foi enviado",
                  "erro": {}
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos ou incompletos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "401": {
            "description": "Código não solicitado, expirado ou incorreto.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "codigo incorreto"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/LimiteCadastro"
          },
          "500": {
            "description": "Erro ao cadastrar usuário",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        },
        "description": "Exige nome, email contendo @ e .com, senha com no mínimo 10 caracteres e código enviado por POST /solicitar-codigo. O código tem seis dígitos, expira em 10 minutos e é consumido ao ser validado. Retorna 200 no cadastro completo ou 201 se o cadastro foi criado, mas o envio do email de boas-vindas falhou."
      }
    },
    "/solicitar-codigo": {
      "post": {
        "summary": "Envia código para confirmar o cadastro",
        "tags": [
          "Solicita codigo por Email"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome",
                  "email"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "Joao Sousa"
                  },
                  "email": {
                    "type": "string",
                    "example": "usuario@exemplo.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Codigo enviado para o email!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos ou incompletos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "409": {
            "description": "Esse email já está cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/LimiteCodigo"
          },
          "500": {
            "description": "O envio de email falhou.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "mensagem": {
                      "type": "string"
                    },
                    "erro": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                },
                "example": {
                  "mensagem": "O envio de email falhou!",
                  "erro": {}
                }
              }
            }
          }
        },
        "description": "Exige nome e email contendo @ e .com. Rejeita email já cadastrado. O código tem seis dígitos e expira em 10 minutos. Uma nova solicitação substitui o código anterior desse email."
      }
    },
    "/solicitar-reset-senha": {
      "post": {
        "summary": "Solicita um código de verificação para redefinir a senha",
        "tags": [
          "Redefinição de Senha"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@gmail.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código enviado para o email!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "400": {
            "description": "Email inválido ou não informado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "404": {
            "description": "Email não cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/LimiteCodigo"
          },
          "500": {
            "description": "Erro ao consultar usuário ou não foi possível enviar o código",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        },
        "description": "Exige email contendo @ e cadastrado no banco. Envia código de seis dígitos com validade de 10 minutos; uma nova solicitação substitui o código anterior desse email."
      }
    },
    "/confirmar-reset-senha": {
      "post": {
        "summary": "Confirma o código de verificação e atualiza a senha",
        "tags": [
          "Redefinição de Senha"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "codigoDigitado",
                  "novaSenha"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "example": "usuario@gmail.com"
                  },
                  "codigoDigitado": {
                    "type": "string",
                    "example": "123456"
                  },
                  "novaSenha": {
                    "type": "string",
                    "minLength": 10,
                    "example": "minhaNovaSenha123",
                    "description": "Mínimo de 10 caracteres"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha alterada com sucesso!",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos ou incompletos (código inválido/expirado ou senha menor que 10 caracteres)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "404": {
            "description": "Usuário não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/LimiteCodigo"
          },
          "500": {
            "description": "Erro ao atualizar senha ou erro ao processar sua solicitação",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        },
        "description": "Valida e consome o código de uso único, atualiza o hash da senha e define status_reset_senha como false. Não exige sessão autenticada."
      }
    },
    "/me": {
      "get": {
        "summary": "Consulta o usuário autenticado",
        "description": "Sem id, consulta o usuário da sessão e retorna id_usuario, nome e tipo; falha na consulta ou conta inativa gera 401. Com id, exige tipo Admin no token e retorna apenas status_usuario e tipo do usuário consultado, inclusive se inativo. Falha nessa consulta gera 401.",
        "tags": [
          "Autenticação"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário autenticado ou status e tipo do usuário indicado por id.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id_usuario": {
                          "type": "integer",
                          "example": 1
                        },
                        "nome": {
                          "type": "string"
                        },
                        "tipo": {
                          "type": "string",
                          "example": "Admin"
                        }
                      },
                      "required": [
                        "id_usuario",
                        "nome",
                        "tipo"
                      ]
                    },
                    {
                      "type": "object",
                      "required": [
                        "status_usuario",
                        "tipo"
                      ],
                      "properties": {
                        "status_usuario": {
                          "type": "string",
                          "enum": [
                            "Ativo",
                            "Inativo"
                          ]
                        },
                        "tipo": {
                          "type": "string",
                          "enum": [
                            "Comum",
                            "Admin"
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado, token inválido ou expirado, ou sessão inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "403": {
            "description": "Acesso negado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Acesso negado"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "ID a consultar; somente administradores podem informar este parâmetro.",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/logout": {
      "post": {
        "summary": "Encerra a sessão",
        "description": "Remove o cookie token. Não exige autenticação.",
        "tags": [
          "Autenticação"
        ],
        "responses": {
          "200": {
            "description": "Logout realizado",
            "headers": {
              "Set-Cookie": {
                "description": "Expira o cookie token.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Logout realizado"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/LimiteCodigo"
          }
        }
      }
    },
    "/confirmar-senha": {
      "post": {
        "summary": "Confirma a senha do usuário autenticado",
        "description": "Compara a senha informada com o hash do usuário identificado pelo cookie. Não altera senha nem sessão. Compartilha o limitador de POST /login.",
        "tags": [
          "Autenticação"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Senha correta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Senha correta"
                }
              }
            }
          },
          "400": {
            "description": "Senha incorreta",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Senha incorreta"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/LimiteLogin"
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "senha"
                ],
                "properties": {
                  "senha": {
                    "type": "string",
                    "example": "minhaSenha123"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/usuario": {
      "get": {
        "summary": "Consulta os dados do próprio usuário",
        "description": "Usa o ID do JWT. Não recebe id por query. Consulta sem resultado ou usuário inativo retorna 401.",
        "tags": [
          "Usuário"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Usuario"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado, token inválido ou expirado, ou sessão inválida.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          }
        }
      }
    },
    "/usuario/desativar-usuario": {
      "patch": {
        "summary": "Desativa a própria conta",
        "description": "Usa o ID do JWT, define status_usuario como Inativo e registra data_inativacao. Não recebe corpo e não remove o cookie.",
        "tags": [
          "Usuário"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario desativado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Usuario desativado com sucesso"
                }
              }
            }
          },
          "400": {
            "description": "Usuario já está desativado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Usuario já está desativado"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado, token inválido ou expirado, ou erro ao desativar a conta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Erro ao desativar a conta, tente novamente mais tarde"
                }
              }
            }
          }
        }
      }
    },
    "/usuario/atualizar-dados": {
      "patch": {
        "summary": "Atualiza o nome do próprio usuário",
        "description": "Usa o ID do JWT e atualiza apenas nome. O handler não implementa validação explícita de campos obrigatórios ou tamanho.",
        "tags": [
          "Usuário"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados atualizados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Dados atualizados com sucesso"
                }
              }
            }
          },
          "500": {
            "description": "Erro em atualizar usuario, seguido do erro retornado pelo banco.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nome"
                ],
                "properties": {
                  "nome": {
                    "type": "string",
                    "example": "João Sousa"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/listar-usuarios": {
      "get": {
        "summary": "Lista ou pesquisa usuários (Admin)",
        "description": "Exige tipo Admin no JWT. Sem pesquisa ou com pesquisa vazia, retorna todos os usuários com status 200. Com pesquisa, filtra por parte do nome sem diferenciar maiúsculas e minúsculas e também por ID exato se o termo for numérico; retorna status 201. Ordena por id_usuario crescente. A lista pode estar vazia. Não aplica limitador de requisições.",
        "tags": [
          "Administração de usuários"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "pesquisa",
            "in": "query",
            "required": false,
            "description": "Nome parcial ou ID do usuário.",
            "schema": {
              "type": "string"
            },
            "example": "Joao"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista completa de usuários; pesquisa ausente ou vazia.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioAdministrativo"
                  }
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Impede o armazenamento da resposta em cache.",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SomenteAdmin"
          },
          "500": {
            "description": "Erro na consulta ao banco de dados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            }
          },
          "201": {
            "description": "Lista de usuários filtrada pela pesquisa.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioAdministrativo"
                  }
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "description": "Impede o armazenamento da resposta em cache.",
                "schema": {
                  "type": "string",
                  "example": "no-store"
                }
              }
            }
          }
        }
      }
    },
    "/admin/deletar-usuario": {
      "delete": {
        "summary": "Exclui permanentemente um usuário (Admin)",
        "description": "Exige tipo Admin no token. Recebe o ID pela query string. Retorna sucesso mesmo quando nenhum usuário corresponde ao ID informado.",
        "tags": [
          "Administração de usuários"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id_usuario",
            "in": "query",
            "required": true,
            "description": "ID do usuário a excluir permanentemente.",
            "schema": {
              "type": "integer"
            },
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Operação com sucesso, usuario deletado permanentemente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Operação com sucesso, usuario deletado permanentemente"
                }
              }
            }
          },
          "400": {
            "description": "Backend não recebeu o id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Backend não recebeu o id"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SomenteAdmin"
          },
          "500": {
            "description": "Erro ao deletar o usuario, verifique o banco de dados",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Erro ao deletar o usuario, verifique o banco de dados"
                }
              }
            }
          }
        }
      }
    },
    "/admin/usuario": {
      "get": {
        "summary": "Consulta os dados de um usuário (Admin)",
        "description": "Com id, consulta o usuário indicado. Sem id, consulta o próprio administrador. Retorna também contas inativas. Não retorna tipo nem status_reset_senha.",
        "tags": [
          "Administração de usuários"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetalheUsuarioAdministrativo"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado, token inválido ou expirado, ou falha ao consultar o usuário.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Usuario não existe ou inativo"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/SomenteAdmin"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "ID do usuário. Se omitido, usa o ID do JWT.",
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/admin/editar-usuario": {
      "patch": {
        "summary": "Atualiza nome e email de um usuário (Admin)",
        "description": "Seleciona o usuário pelo id do corpo. Atualiza nome e email. Não há validação explícita dos campos nem verificação de linha atualizada; pode retornar sucesso sem correspondência para o ID.",
        "tags": [
          "Administração de usuários"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados atualizados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Dados atualizados com sucesso"
                }
              }
            }
          },
          "500": {
            "description": "Erro em atualizar usuario, seguido do erro retornado pelo banco.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SomenteAdmin"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "nome",
                  "email"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "example": 1
                  },
                  "nome": {
                    "type": "string",
                    "example": "João Sousa"
                  },
                  "email": {
                    "type": "string",
                    "example": "joao@exemplo.com"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/admin/resetar-senha": {
      "patch": {
        "summary": "Solicita redefinição de senha de um usuário (Admin)",
        "description": "Define status_reset_senha como true. Não altera a senha nem envia código por email. Os próximos logins retornam 203 até a conclusão de POST /confirmar-reset-senha.",
        "tags": [
          "Administração de usuários"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitação de reset da senha realizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Solicitação de reset da senha realizada"
                }
              }
            }
          },
          "400": {
            "description": "Já foi feita uma solicitação de reset de senha para este usuario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Já foi feita uma solicitação de reset de senha para este usuario"
                }
              }
            }
          },
          "500": {
            "description": "Ocorreu um erro ao consultar o usuario, verifique os logs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Ocorreu um erro ao consultar o usuario, verifique os logs"
                }
              }
            }
          },
          "501": {
            "description": "Ocorreu um erro com sua solicitação, verifique os logs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mensagem"
                },
                "example": {
                  "mensagem": "Ocorreu um erro com sua solicitação, verifique os logs"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/SomenteAdmin"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "example": 1
                  }
                }
              }
            }
          }
        }
      }
